import time
from align_python import (
    read_fasta_one,
    global_align_score,
)

def p(fname):  # data folder is sibling of code/
    return f"../data/{fname}"

def run_case(method, lang, func, a_path, b_path, label):
    s = read_fasta_one(a_path)
    t = read_fasta_one(b_path)
    t0 = time.perf_counter()
    _ = func(s, t)
    ms = int((time.perf_counter() - t0) * 1000.0)
    print(f"{method}-{label:<11} {lang:<10} {ms}ms")

def main():
    # Only ONE test: global alignment on MT pair in Python
    run_case("global", "python",
             global_align_score,
             p("MT-human.fa"),
             p("MT-orang.fa"),
             "mt_human")

if __name__ == "__main__":
    main()
